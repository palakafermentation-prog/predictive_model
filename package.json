{
  "name": "@pferm/web",
  "version": "0.1.7",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "turbo run build && next build",
    "build:packages": "turbo run build",
    "dev": "next dev",
    "lint": "eslint .",
    "type-check": "turbo run build && tsc --noEmit",
    "clean": "turbo run clean && rm -rf node_modules .next out",
    "postversion": "pnpm -r exec pnpm pkg set version=$npm_package_version",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@pferm/shared-lib": "workspace:*",
    "@pferm/shared-schemas": "workspace:*",
    "@prisma/adapter-pg": "7.4.1",
    "@prisma/client": "7.4.1",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-auth": "1.4.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie": "1.1.1",
    "lucide-react": "0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "nodemailer": "8.0.1",
    "pg": "8.18.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "7.71.2",
    "sharp": "^0.34.5",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "zod": "catalog:",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.1.6",
    "@pferm/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.2.0",
    "@types/node": "25.3.0",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sharp": "^0.32.0",
    "dotenv": "17.3.1",
    "eslint": "10.0.1",
    "prisma": "7.4.1",
    "tailwindcss": "4.2.0",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.21.0",
    "turbo": "^2.8.0",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
